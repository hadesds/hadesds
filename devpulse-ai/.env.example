# =====================================================================
# DevPulse AI — copie para .env e preencha. NUNCA versione o arquivo .env.
# Valores entre <> são exemplos; não são credenciais reais.
# =====================================================================

# ---------- Aplicação ----------
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=America/Fortaleza
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# Senha do painel (mínimo 10 caracteres)
ADMIN_PASSWORD=
# Porta local do painel (http://localhost:8080). Fica presa a 127.0.0.1.
DASHBOARD_PORT=8080
# Endereço citado nos e-mails (só funciona no seu computador)
DASHBOARD_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
# Módulos Python extras com novos conectores (opcional), separados por vírgula
PLUGIN_MODULES=

# ---------- Banco de dados ----------
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=
POSTGRES_DB=devpulse
# Porta do PostgreSQL exposta só em 127.0.0.1 (para psql/depuração)
DB_PORT=5433

# ---------- Agenda e limites ----------
EDITION_MAIN_TIME=08:00
# Edição complementar opcional (HH:MM) — vazio desativa
EDITION_SECONDARY_TIME=
# Se o PC estava desligado às 8h, a edição ainda roda até este horário; depois, não é enviada
EDITION_CATCHUP_UNTIL=14:00
COLLECT_INTERVAL_MINUTES=60
# Limite global de roteiros por dia (0 a 3), compartilhado entre e-mail e WhatsApp
DAILY_SCRIPT_LIMIT=3

# ---------- Provedor de IA ----------
# anthropic | openai_compatible | none  (none = roteiro-base extrativo, sem custo)
LLM_PROVIDER=none
LLM_API_KEY=
# Só para openai_compatible (OpenAI, OpenRouter, Ollama: http://host.docker.internal:11434/v1)
LLM_BASE_URL=
LLM_MODEL_SCRIPT=claude-opus-5-5
# Modelo econômico para pontuação/classificação
LLM_MODEL_FAST=claude-haiku-5-5
# Limites aplicados pelo DevPulse (efetivos)
LLM_MAX_CALLS_PER_DAY=40
LLM_MAX_OUTPUT_TOKENS_PER_DAY=400000
# Preços usados só para ESTIMAR custo (US$ por milhão de tokens) — confira a tabela do provedor
LLM_PRICE_INPUT_PER_MTOK=4.0
LLM_PRICE_OUTPUT_PER_MTOK=20.0

# ---------- Caixa que RECEBE as newsletters ----------
# O remetente da TechDrops (tech@newsletter.thedrops.com.br) fica em config/sources.yaml.
# Aqui vai a SUA conta de recebimento. none | imap | gmail | graph
NEWSLETTER_MAILBOX_PROVIDER=none
NEWSLETTER_MAILBOX_ADDRESS=<sua-conta@gmail.com>
# IMAP (senha de app; somente leitura com BODY.PEEK)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Gmail API (escopo gmail.readonly) — gere o refresh token com scripts/oauth_gmail.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Microsoft Graph (Mail.Read delegado) — gere com scripts/oauth_graph.py
GRAPH_TENANT_ID=consumers
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=

# ---------- E-mail de saída (SMTP autenticado) ----------
EMAIL_ENABLED=false
# Destinatário das edições (também editável no painel)
EMAIL_RECIPIENT=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (porta 587) | ssl (porta 465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- WhatsApp Business Platform (Cloud API oficial) ----------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Número destinatário em E.164, ex.: +5598999999999
WHATSAPP_RECIPIENT=
# Confirme apenas se o destinatário aceitou receber mensagens deste número (opt-in)
WHATSAPP_RECIPIENT_OPT_IN=false
# template (exigido fora da janela de 24h) | text (só dentro da janela)
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_NAME=devpulse_edicao
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# ---------- Opcional ----------
# Token sem permissões (só leitura pública) para aumentar o limite da API do GitHub
GITHUB_TOKEN=
